# Public repository contents. Local planning, evidence and runtime data stay local.
/*
!/.gitignore
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/README.md
!/README.zh-CN.md
!/package.json
!/pnpm-lock.yaml
!/cordis.patch.yml
!/tsconfig.json
!/tsconfig.build.json
!/tsdown.config.ts
!/vitest.config.ts
!/vitest.artifact.config.ts
!/src/
!/skill/
!/tests/
!/build/
!/lib/
!/docs/
/docs/*
!/docs/tool-loading-and-cache.md
!/docs/images/
/docs/images/*
!/docs/images/desktop-install.png
!/docs/images/available-tools-preview.png
!/docs/images/skill-binding.png
!/docs/images/mcp-tool-bindings.png
!/docs/images/skill-bindings-filter.png
!/docs/images/always-blocked-tool.png
!/docs/images/initial-tool-list-check-1.png
!/docs/images/initial-tool-list-check-2.png
!/docs/images/skill-loaded-tools-ready.png

# Never commit dependencies, local settings, credentials or transient outputs.
**/node_modules/
**/.env
**/.env.*
**/.npmrc
**/*.log
**/*.tgz
**/*.tsbuildinfo
**/coverage/
**/.DS_Store
**/Thumbs.db
